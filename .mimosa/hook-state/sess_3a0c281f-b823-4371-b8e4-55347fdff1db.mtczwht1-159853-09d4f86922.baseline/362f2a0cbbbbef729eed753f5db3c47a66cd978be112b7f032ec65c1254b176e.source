{
  "name": "unomi-didvc-interop-wallet",
  "private": true,
  "description": "Reference-wallet round trip for the unomi-did-vc credential edge, built on the OpenWallet Foundation @openid4vc client libraries (third-party OID4VCI/OID4VP implementation) plus jose.",
  "type": "module",
  "dependencies": {
    "@openid4vc/oauth2": "0.5.5",
    "@openid4vc/openid4vci": "0.5.5",
    "@openid4vc/openid4vp": "0.5.5",
    "@openid4vc/utils": "0.5.5",
    "jose": "5.9.6",
    "tsx": "4.19.2"
  }
}
