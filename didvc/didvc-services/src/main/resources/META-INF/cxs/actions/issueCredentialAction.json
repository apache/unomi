{
  "metadata": {
    "id": "didvcIssueCredentialAction",
    "name": "Issue Verifiable Credential",
    "description": "Issues a verifiable credential from event/profile claims (unomi-did-vc). Selective claims stay selectively disclosable.",
    "systemTags": [
      "didvc",
      "identity"
    ],
    "readOnly": true
  },
  "actionExecutor": "issueCredential",
  "parameters": [
    {
      "id": "schemaId",
      "type": "string",
      "multivalued": false
    },
    {
      "id": "kid",
      "type": "string",
      "multivalued": false
    },
    {
      "id": "verifierCategory",
      "type": "string",
      "multivalued": false
    },
    {
      "id": "validityDays",
      "type": "integer",
      "multivalued": false,
      "defaultValue": "365"
    },
    {
      "id": "claimsJson",
      "type": "string",
      "multivalued": false
    },
    {
      "id": "selectiveClaims",
      "type": "string",
      "multivalued": true
    }
  ]
}
