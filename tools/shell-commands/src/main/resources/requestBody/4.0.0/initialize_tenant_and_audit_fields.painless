// Decide the tenant for this document (UNOMI-997).
// Shipped definitions and geonames go to system. User-created rules/segments/scorings/goals
// stay in the configured tenant even when their 3.0 scope is "systemscope".
boolean useSystemTenant = false;
if (params.forceDefaultTenant != true) {
    def itemTypeLower = ctx._source.itemType != null ? ctx._source.itemType.toLowerCase() : '';
    def rawId = ctx._source.itemId != null ? ctx._source.itemId : ctx._id;
    def baseId = rawId;
    if (baseId != null && itemTypeLower != '' && baseId.toLowerCase().endsWith('_' + itemTypeLower)) {
        baseId = baseId.substring(0, baseId.length() - itemTypeLower.length() - 1);
    }
    if (itemTypeLower == 'geonameentry' || (ctx._index != null && ctx._index.toLowerCase().endsWith('-geonameentry'))) {
        useSystemTenant = true;
    } else if (baseId != null && params.shippedDefinitionIds != null
            && params.shippedDefinitionIds.contains(itemTypeLower + ':' + baseId.toLowerCase())) {
        useSystemTenant = true;
    } else if (ctx._source.scope != null && ctx._source.scope == 'system') {
        // Literal "system" only — not the 3.0 default "systemscope"
        useSystemTenant = true;
    }
}
def assignedTenantId = useSystemTenant ? params.systemTenantId : params.tenantId;

// Update document ID with tenant prefix
if (ctx._id != null) {
    // Skip if already has tenant prefix
    if (!ctx._id.startsWith(params.tenantId + '_') && !ctx._id.startsWith(params.systemTenantId + '_')) {
        def baseId = ctx._id;
        if (ctx._index != null && ctx._index.toLowerCase().endsWith('-systemitems')) {
            // For system items, ensure itemType is lowercase and matches the format in ElasticSearchPersistenceServiceImpl
            def itemType = ctx._source.itemType != null ? ctx._source.itemType.toLowerCase() : null;
            if (itemType != null && params.systemItems != null && params.systemItems.contains(itemType)) {
                ctx._id = assignedTenantId + '_' + baseId + '_' + itemType;
            } else {
                ctx._id = assignedTenantId + '_' + baseId;
            }
        } else {
            ctx._id = assignedTenantId + '_' + baseId;
        }
    }
}

// Update audit fields (skip geonames — not asserted and high volume).
// systemitems must get audit here: UNOMI-997 puts shipped defs under the system
// tenant before Unomi starts, so bundle deploy treats them as updates and would
// otherwise leave createdBy unset on docs that never had it.
def indexLower = ctx._index != null ? ctx._index.toLowerCase() : '';
if (!indexLower.endsWith('-geonameentry') && !indexLower.endsWith('-geonames')) {
    // Handle creation date based on item type
    if (ctx._source.creationDate == null) {
        if (params.itemType == 'profile' && ctx._source.properties != null) {
            if (ctx._source.properties.firstVisit != null) {
                ctx._source.creationDate = ctx._source.properties.firstVisit;
            } else {
                ctx._source.creationDate = params.date;
            }
        } else if ((params.itemType == 'event' || params.itemType == 'session') && ctx._source.timeStamp != null) {
            ctx._source.creationDate = ctx._source.timeStamp;
        } else {
            ctx._source.creationDate = params.date;
        }
    }

    // Handle last modification date based on item type
    if (ctx._source.lastModificationDate == null) {
        if (params.itemType == 'profile' && ctx._source.properties != null) {
            if (ctx._source.properties.lastVisit != null) {
                ctx._source.lastModificationDate = ctx._source.properties.lastVisit;
            } else {
                ctx._source.lastModificationDate = ctx._source.creationDate;
            }
        } else if (params.itemType == 'session' && ctx._source.lastEventDate != null) {
            ctx._source.lastModificationDate = ctx._source.lastEventDate;
        } else {
            ctx._source.lastModificationDate = ctx._source.creationDate;
        }
    }

    // Set creator fields
    if (ctx._source.createdBy == null) {
        ctx._source.createdBy = 'system-migration-4.0.0';
    }
    if (ctx._source.lastModifiedBy == null) {
        ctx._source.lastModifiedBy = 'system-migration-4.0.0';
    }

    // Initialize source tracking fields
    if (ctx._source.sourceInstanceId == null) {
        ctx._source.sourceInstanceId = null;
    }
    if (ctx._source.lastSyncDate == null) {
        ctx._source.lastSyncDate = null;
    }
}

// Set tenant ID in the source document
if (ctx._source.tenantId == null) {
    ctx._source.tenantId = assignedTenantId;
}
