<featuresProcessing xmlns="http://karaf.apache.org/xmlns/features-processing/v1.0.0">

    <!-- The Apache CXF features name their own Jackson version. These replacements keep one Jackson version in the distribution. -->
    <bundleReplacements>
        <bundle originalUri="mvn:com.fasterxml.jackson.core/jackson-core/[2,${jackson.version})" replacement="mvn:com.fasterxml.jackson.core/jackson-core/${jackson.version}" mode="maven"/>
        <bundle originalUri="mvn:com.fasterxml.jackson.core/jackson-annotations/[2,${jackson-annotations.version})" replacement="mvn:com.fasterxml.jackson.core/jackson-annotations/${jackson-annotations.version}" mode="maven"/>
        <bundle originalUri="mvn:com.fasterxml.jackson.core/jackson-databind/[2,${jackson.version})" replacement="mvn:com.fasterxml.jackson.core/jackson-databind/${jackson.version}" mode="maven"/>
        <bundle originalUri="mvn:com.fasterxml.jackson.dataformat/jackson-dataformat-yaml/[2,${jackson.version})" replacement="mvn:com.fasterxml.jackson.dataformat/jackson-dataformat-yaml/${jackson.version}" mode="maven"/>
        <bundle originalUri="mvn:com.fasterxml.jackson.datatype/jackson-datatype-jsr310/[2,${jackson.version})" replacement="mvn:com.fasterxml.jackson.datatype/jackson-datatype-jsr310/${jackson.version}" mode="maven"/>
        <bundle originalUri="mvn:com.fasterxml.jackson.jaxrs/jackson-jaxrs-base/[2,${jackson.version})" replacement="mvn:com.fasterxml.jackson.jaxrs/jackson-jaxrs-base/${jackson.version}" mode="maven"/>
        <bundle originalUri="mvn:com.fasterxml.jackson.jaxrs/jackson-jaxrs-json-provider/[2,${jackson.version})" replacement="mvn:com.fasterxml.jackson.jaxrs/jackson-jaxrs-json-provider/${jackson.version}" mode="maven"/>
        <bundle originalUri="mvn:org.yaml/snakeyaml/[2,${snakeyaml.version})" replacement="mvn:org.yaml/snakeyaml/${snakeyaml.version}" mode="maven"/>
    </bundleReplacements>

</featuresProcessing>
